# Server-only environment variables. Copy this file to the ignored root .env,
# fill values locally, then restart pnpm dev. Use Fly secrets when deploying.
# Never put credentials in public/ or a tracked file.
APP_ORIGIN=https://your-app.fly.dev
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-brevo-smtp-login
SMTP_PASSWORD=replace-with-brevo-smtp-key
MAIL_FROM=Frontier <verified-sender@your-domain.example>
