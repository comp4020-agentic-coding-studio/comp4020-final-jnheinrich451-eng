node_modules/
dist/
*.log

# Local source asset library. Copy selected runtime assets and their licenses
# into a tracked game directory before using them in the deployed app.
/assets/
.local/
test-results/
playwright-report/

# Generated concept images and test renders stay local (the folder is large).
# The *-prompt.txt files beside them stay tracked as provenance evidence.
/output/**/*.png
/output/**/*.mp4
/output/**/*.webm

# Intro video workspace: derived layers and renders are rebuilt, not tracked.
/video/public/layers/
/video/out/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
